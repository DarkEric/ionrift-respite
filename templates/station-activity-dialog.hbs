        </div>
        </div>
        <div class="station-meal-submit-row">
            <button type="button" class="station-meal-submit-btn" data-action="submitStationRations">{{localize 'IONRIFT.RESPITE.MEAL.SubmitRations'}}</button>
        </div>
        {{/if}}
        {{/with}}
        {{else}}
        <p class="station-no-activities">{{localize 'IONRIFT.RESPITE.STATION.RationsNotReady'}}</p>
        {{/if}}
    </div>
    {{/if}}
    {{/if}}

    {{!-- Cooking station: cook / brew activities --}}
    {{#if showStationTabs}}
    {{#if (eq stationPanelTab "cooking")}}
    {{#if actorChoiceLocked}}
    <div class="station-cooking-gate station-cooking-gate--activity-locked">
        <i class="fas fa-check-circle station-cooking-gate-icon" aria-hidden="true"></i>
        <p class="station-cooking-gate-text">{{{localize 'IONRIFT.RESPITE.STATION.AlreadyChose' name=actorName activity=actorChoiceLocked}}}</p>
    </div>
    {{/if}}
    {{#unless actorHasCookingUtensils}}
    <div class="station-cooking-gate">
        <i class="fas fa-utensils station-cooking-gate-icon"></i>
        <p class="station-cooking-gate-text">{{localize 'IONRIFT.RESPITE.STATION.NoCookingTools' name=actorName}}</p>
    </div>
    {{else}}
    {{#if hasCookingAny}}
    <ul class="station-activities">
        {{#each cookingActivities}}
        <li>
            {{#if (and this.available (not ../actorChoiceLocked))}}
            <button type="button"
                    class="activity-card station-activity"
                    data-action="selectActivity"
                    data-activity-id="{{this.id}}">
                <i class="{{this.icon}}" aria-hidden="true"></i>
                <div class="card-body">
                    <span class="card-name">{{this.name}}</span>
                    {{#if this.hint}}<span class="card-hint {{#if this.hintUrgent}}urgent{{/if}}">{{this.hint}}</span>{{/if}}
                </div>
            </button>
            {{else if this.nonViable}}
            <div class="activity-card station-activity non-viable" data-tooltip="{{this.fadedHint}}">
                <i class="{{this.icon}}" aria-hidden="true"></i>
                <div class="card-body">
                    <span class="card-name">{{this.name}}</span>
                    {{#if this.hint}}<span class="card-hint non-viable-hint">{{this.hint}}</span>{{/if}}
                </div>
            </div>
            {{else}}
            <div class="activity-card station-activity faded" data-tooltip="{{this.fadedHint}}">
                <i class="{{this.icon}}" aria-hidden="true"></i>
                <div class="card-body">
                    <span class="card-name">{{this.name}}</span>
                    {{#if this.hint}}<span class="card-hint faded-hint">{{this.hint}}</span>{{/if}}
                </div>
            </div>
            {{/if}}
        </li>
        {{/each}}
    </ul>
    {{else}}
    <p class="station-no-activities">{{localize 'IONRIFT.RESPITE.STATION.NoCookBrew' name=actorName}}</p>
    {{/if}}
    {{/unless}}
    {{/if}}
    {{/if}}

    {{!-- Workbench: Examine tab (Focus/Potion self-service, all players) --}}
    {{#if showStationTabs}}
    {{#if workbenchExamineEnabled}}
    {{#if (eq stationPanelTab "examine")}}
    {{> workbenchIdentifyEmbed}}
    {{/if}}
    {{/if}}
    {{/if}}

    {{!-- Workbench: Identify tab (click-to-identify party list, GM + Identify casters) --}}
    {{#if showStationTabs}}
    {{#if workbenchIdentifyUiEnabled}}
    {{#if canSeeSharedPool}}
    {{#if (eq stationPanelTab "identify")}}
    <div class="station-identify-embed wb-ident-party-list-tab">
        {{#if unidentifiedItemsByOwner.length}}
        <div class="wb-ident-pool-heading">
            <i class="fas fa-hat-wizard"></i> {{localize 'IONRIFT.RESPITE.WORKBENCH.CastIdentifySelect'}}
        </div>
        {{#each unidentifiedItemsByOwner}}
        <div class="wb-ident-owner-group">
            <span class="wb-ident-owner-name">{{ownerName}}</span>
            {{#each items}}
            <button type="button" class="wb-ident-pool-row wb-ident-pool-btn"
                 data-action="identifyPoolItem"
                 data-item-actor-id="{{actorId}}" data-item-id="{{itemId}}"
                 data-tooltip="{{localize 'IONRIFT.RESPITE.WORKBENCH.IdentifyOwnedBy' name=name owner=actorName}}">
                <img src="{{img}}" alt="" class="wb-ident-pool-icon"
                     onerror="this.onerror=null;this.src='icons/svg/mystery-man.svg'">
                <span class="wb-ident-pool-name">{{name}}</span>
                <span class="wb-ident-pool-rarity rarity-{{rarity}}">{{rarityLabel}}</span>
                <i class="fas fa-hat-wizard wb-ident-cast-icon"></i>
            </button>
            {{/each}}
        </div>
        {{/each}}
        {{else}}
        <div class="wb-ident-pool-empty">
            <i class="fas fa-check-circle"></i> {{localize 'IONRIFT.RESPITE.WORKBENCH.NoUnidentified'}}
        </div>
        {{/if}}
    </div>
    {{/if}}
    {{/if}}
    {{/if}}
    {{/if}}

    {{/if}}{{!-- end dialogState === "list" --}}
</div>
