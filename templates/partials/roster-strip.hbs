{{!-- Roster strip: selection + activity; .afk + fa-mug-hot badge (same language as TABLE AFK panel) --}}
{{#if roster.length}}
<div class="roster-strip">
    <div class="roster-players">
        {{#each roster}}
        <div class="roster-chip {{#if isSelected}}selected{{/if}} {{source}} {{#unless isOwner}}not-owned{{/unless}} {{#if isAfk}}afk{{/if}} {{#if mealStatus}}meal-{{mealStatus.state}}{{/if}}"
            data-roster-id="{{id}}" data-tooltip="{{fullName}}">
            <span class="roster-portrait-wrap">
                <img class="roster-portrait" src="{{img}}" alt="{{name}}">
                {{#if isAfk}}<span class="roster-afk-mug" aria-hidden="true"><i class="fas fa-mug-hot"></i></span>{{/if}}
                {{#if isBeddedDown}}<span class="roster-zzz" aria-hidden="true">{{localize 'IONRIFT.RESPITE.UI.Zzz'}}</span>{{/if}}
            </span>
            <span class="roster-name">{{name}}</span>
            {{#if activityLabel}}<span class="roster-activity-label" data-tooltip="{{activityLabel}}">{{activityLabel}}</span>{{/if}}
            <span class="roster-status">
                {{#if (eq rollMode 'force-pass')}}
                <i class="fas fa-check roster-roll-force-pass" data-tooltip="{{localize 'IONRIFT.RESPITE.UI.AutoPassTooltip'}}"></i>
                {{else if (eq rollMode 'force-fail')}}
                <i class="fas fa-times roster-roll-force-fail" data-tooltip="{{localize 'IONRIFT.RESPITE.UI.AutoFailTooltip'}}"></i>
                {{else if pendingRoll}}
                <i class="fas fa-dice-d20 roster-roll-pending" data-tooltip="{{#if (eq rollMode 'advantage')}}{{localize 'IONRIFT.RESPITE.UI.AwaitingRollAdv'}}{{else if (eq rollMode 'disadvantage')}}{{localize 'IONRIFT.RESPITE.UI.AwaitingRollDis'}}{{else}}{{localize 'IONRIFT.RESPITE.UI.AwaitingRoll'}}{{/if}}"></i>
                {{#if (eq rollMode 'advantage')}}<i class="fas fa-angle-up roster-roll-adv" aria-hidden="true"></i>{{/if}}
                {{#if (eq rollMode 'disadvantage')}}<i class="fas fa-angle-down roster-roll-dis" aria-hidden="true"></i>{{/if}}
                {{else if rolledResult}}
                <i class="fas fa-check-circle roster-roll-done" data-tooltip="{{localize 'IONRIFT.RESPITE.UI.RolledResult' result=rolledResult}}"></i>
                {{else if exhaustion}}
                <i class="fas fa-skull roster-exhaustion" data-tooltip="{{localize 'IONRIFT.RESPITE.UI.ExhaustionLevel' level=exhaustion}}"></i>
                {{else if (eq source 'player')}}
                <i class="fas fa-check-circle roster-resolved" data-tooltip="{{localize 'IONRIFT.RESPITE.UI.ActivityChosen'}}"></i>
                {{else if (eq source 'gm')}}
                <i class="fas fa-crown roster-gm-override" data-tooltip="{{localize 'IONRIFT.RESPITE.UI.GMOverride'}}"></i>
                {{else}}
                <i class="fas fa-clock roster-waiting" data-tooltip="{{localize 'IONRIFT.RESPITE.UI.Waiting'}}"></i>
                {{/if}}
            </span>
            {{#if mealStatus}}
            <span class="roster-meal-status {{mealStatus.state}}" data-tooltip="{{mealStatus.tooltip}}">
                {{#if mealStatus.submitted}}
                <i class="fas fa-check-circle" aria-hidden="true"></i><span class="rms-label">{{localize 'IONRIFT.RESPITE.UI.sent'}}</span>
                {{else}}
                <i class="fas fa-drumstick-bite {{#if mealStatus.foodOk}}ok{{else}}miss{{/if}}" aria-hidden="true"></i>
                <i class="fas fa-tint {{#if mealStatus.waterOk}}ok{{else}}miss{{/if}}" aria-hidden="true"></i>
                {{/if}}
            </span>
            {{/if}}
        </div>
        {{/each}}
    </div>
</div>
{{/if}}
